# Copy this file to .env on the server. Never commit the real .env.
DASHBOARD_DOMAIN=dashboard.example.com
DASHBOARD_SESSION_SECRET=replace-with-at-least-32-random-bytes
DASHBOARD_SESSION_MAX_AGE=28800
# Generate each username:hash fragment with create_user_hash.py; separate accounts with semicolons.
DASHBOARD_USERS=replace_me:replace_with_generated_hash

# MySQL must be reachable from the server and restricted to the server's IP.
MYSQL_HOST=replace-with-mysql-host
MYSQL_PORT=3306
MYSQL_USER=monitoreo_app
MYSQL_PASSWORD=replace-with-database-password
MYSQL_DATABASE=monitoreo_ambiental

# Keep false unless this deployment is configured to ingest MQTT messages.
MQTT_ENABLED=false
