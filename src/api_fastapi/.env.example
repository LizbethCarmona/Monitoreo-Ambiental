# Template for protected local environment settings; never commit the real env file.
# Used by the optional future Caddy deployment, not by the active Tailscale URL.
DASHBOARD_DOMAIN=example.invalid
# Required by compose.tailnet.yaml; use this device's MagicDNS name.
TAILNET_HOSTNAME=
DASHBOARD_SESSION_SECRET=replace-with-at-least-32-random-bytes
DASHBOARD_SESSION_MAX_AGE=28800
# Generate each username:hash fragment with create_user_hash.py; separate accounts with semicolons.
DASHBOARD_USERS=replace_me:replace_with_generated_hash

# Compose runs MySQL privately on its internal network; port 3306 is not published.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
MYSQL_PASSWORD=replace-with-a-different-long-random-app-password
MYSQL_DATABASE=monitoreo_ambiental

# Enables MQTT ingestion; use --profile demo to run the synthetic publisher.
MQTT_ENABLED=true
